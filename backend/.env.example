PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DB_URL=jdbc:mysql://localhost:3306/tgms?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=tgms_user
DB_PASSWORD=replace_with_local_password
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_ALLOW_ROLLBACK=false
PRODUCT_IMAGE_DIRECTORY=./data/product-images
# Local/disposable presentation DB only; read by TGMS-85 demo tooling, not the app.
DEMO_DATA_ALLOWED=false
JWT_SECRET=
JWT_SESSION_HOURS=8
# Local HTTP development only. The prod profile forces Secure cookies.
COOKIE_SECURE=false

# Authentication email delivery (customer verification codes and password resets)
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RESEND_SECONDS=60
SMTP_ENABLED=false
MAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_AUTH=true
SMTP_USE_STARTTLS=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

# Operational notifications
NOTIFICATIONS_ENABLED=true
